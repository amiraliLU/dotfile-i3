{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/gang.txt",
        "color": {
            "1": "White",
            "2": "White",
            "3": "White"
        }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "  OS" },
        { "type": "wm", "key": "  WM" },
        { "type": "memory", "key": "RAM" },
        { "type": "disk", "key": "Disk" },
        "break",
        "colors"
    ]
}
